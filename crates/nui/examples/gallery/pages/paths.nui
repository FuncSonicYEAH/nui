// Paths — filled polygons through earcut and stroked cubic curves through
// the capsule pipeline. No host code at all: the whole shape is the `d`
// attribute, so this page is also the shortest demonstration that the path
// pipeline needs nothing imperative.
Column(id = paths_page, spacing = 20dp, padding = 24dp) {

    Text(content = "path fill + stroke", font.size = 14dp, color = #e8ecf2)

    Path(width = 292dp, height = 140dp,
         d = "M 10 10 L 282 10 L 146 130 Z",
         fill = #ff5544, stroke.width = 3dp, stroke.color = #ffffff)

    Path(width = 292dp, height = 120dp,
         d = "M 146 10 L 157.8 43.8 L 193.6 44.5 L 165 66.2 L 175.4 100.5 L 146 80 L 116.6 100.5 L 127 66.2 L 98.4 44.5 L 134.2 43.8 Z",
         fill = #7bc47f)

    Path(width = 292dp, height = 110dp,
         d = "M 40 70 C 40 25 100 25 146 45 S 240 100 252 60 Q 260 20 200 18 T 60 40 Z",
         fill = #55aaee, stroke.width = 2dp, stroke.color = #ddeeff)
}
