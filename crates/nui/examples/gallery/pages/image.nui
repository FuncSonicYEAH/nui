// Image — the async decode path, a soft SDF shadow, and nine-slice
// scaling. The texture is generated by the host at startup (a 64x64 BMP
// written to the temp directory, so the demo needs no asset file and no
// image encoder dependency); `{{texture}}` is replaced with its path by
// `document()`.
//
// Nine-slice in action: the source is 64x64 but the element is 300x120,
// and `slice = 20dp` keeps the rounded corners from stretching.
Column(id = image_page, spacing = 20dp, padding = 28dp) {
    Text(content = "Image + shadow", font.size = 16dp, color = #e8ecf2)

    Rectangle(id = image_card, width = 300dp, height = 120dp, radius = 12dp,
              fill = #2b3240,
              shadow.dx = 0dp, shadow.dy = 10dp,
              shadow.blur = 16dp, shadow.color = #000000b0)

    Image(id = image_picture, source = "{{texture}}",
          width = 300dp, height = 120dp, slice = 20dp, tint = #ffffff)

    Text(content = "slice = 20dp over a 64x64 source",
         font.size = 13dp, color = #9aa4b2)
}
