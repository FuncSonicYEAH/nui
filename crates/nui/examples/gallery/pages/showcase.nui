// Scroll + layers, and the type scale.
//
// Where render features go to be seen. The scale is `font.weight` ascending
// from 100 to 900 with `font.italic` turned on for the last two, so the two
// axes can be told apart at a glance — which is the thing worth looking at,
// since either on its own is unremarkable.
//
// The weights are the host's own fonts, so how heavy "Bold" actually is depends
// on what is installed. A snapshot therefore cannot pin these widths.
Column(id = showcase_page, spacing = 16dp, padding = 24dp) {

    Text(content = "font.weight / font.italic / font.family", font.size = 16dp,
         color = #e8ecf2)

    Column(id = showcase_type, spacing = 2dp, width = 340dp) {
        For(row in root.showcaseWeights) {
            Text(content = row.label, font.size = 17dp, align_self = "start",
                 font.weight = row.weight, font.italic = row.italic,
                 color = #e8ecf2)
        }
    }

    Rectangle(id = showcase_type_rule, width = 340dp, height = 1dp,
              fill = #2b3240)

    Text(content = "layer.opacity / layer.blur", font.size = 16dp,
         color = #e8ecf2)

    Rectangle(id = showcase_card, width = 340dp, height = 84dp, radius = 12dp,
              fill = #2b3240,
              shadow.dx = 0dp, shadow.dy = 8dp,
              shadow.blur = 14dp, shadow.color = #000000aa) {
        layer.opacity = 0.85
    }

    Rectangle(id = showcase_pill, width = 180dp, height = 36dp, radius = 9dp,
              fill = #336699) {
        layer.blur = 3dp
    }

    Text(content = "Scroll — wheel over this list", font.size = 13dp,
         color = #9aa4b2)

    Scroll(id = showcase_scroll, width = 340dp, height = 200dp, radius = 10dp,
           fill = #161a22) {
        For(item in root.showcaseRows) {
            Rectangle(id = showcase_row, width = 316dp, height = 36dp,
                      radius = 6dp,
                      fill <- item.hot ? #3d6a9e : #2b3240)
        }
    }
}
