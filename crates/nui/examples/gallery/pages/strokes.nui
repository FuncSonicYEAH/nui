// Strokes — a polyline "chart" (round caps), a hairline divider (butt
// caps), and an arc progress ring. `start` / `end` sweep clockwise in
// screen coordinates (y down), which is why `-90` starts at the top.
Column(id = strokes_page, spacing = 20dp, padding = 24dp) {

    Text(content = "polyline + arc stroking", font.size = 14dp, color = #e8ecf2)

    Polyline(width = 292dp, height = 110dp,
             points = "0,95 48,60 96,74 144,28 192,46 240,14 292,30",
             stroke.width = 3dp, color = #55aaee)

    Polyline(width = 292dp, height = 2dp, points = "0,0 292,0",
             stroke.width = 2dp, stroke.cap = "butt", color = #444a55)

    Arc(width = 150dp, height = 150dp, cx = 75, cy = 75, radius = 60,
        start = -90, end = 180,
        stroke.width = 8dp, stroke.cap = "round", color = #e05555)
}
